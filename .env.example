# ---- Required ----
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Your Telegram user id (get it from @userinfobot). Several: comma separated
ADMIN_TELEGRAM_IDS=
# Domain of the agenda page (DNS A record → the server's public IP, or a Cloudflare Tunnel)
DOMAIN=uni.darwish-tech.com
PUBLIC_URL=https://uni.darwish-tech.com
# Host port of the web page (the reverse proxy / tunnel points here)
APP_PORT=3100
# Extra services: "https" (Caddy on 80/443) or "tunnel" (Cloudflare Tunnel). Empty = none.
COMPOSE_PROFILES=
# Cloudflare Tunnel token (only with COMPOSE_PROFILES=tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
# Database password: letters and digits only (it goes inside a URL). Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- WhatsApp (read-only number) ----
# true after you have a dedicated, warmed-up SIM. The QR code is sent to the admins on Telegram.
WHATSAPP_ENABLED=false

# ---- Models ----
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5

# ---- Optional ----
# Cloudflare R2 / S3 for files (otherwise files stay on the server disk, in the app volume)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Error tracking
SENTRY_DSN=
# Days to keep the text of chit-chat messages
NOISE_RETENTION_DAYS=30
LOG_LEVEL=info
